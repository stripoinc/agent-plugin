{
  "name": "stripo-agent-plugin-maintenance",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.18.1"
  },
  "scripts": {
    "generate": "node scripts/generate-metadata.mjs",
    "check:generated": "node scripts/generate-metadata.mjs --check",
    "validate": "node scripts/validate-plugin.mjs",
    "validate:claude": "claude plugin validate . && claude plugin validate plugins/stripo",
    "check:version": "node scripts/check-version-bump.mjs",
    "test": "node --test scripts/test/*.test.mjs"
  },
  "devDependencies": {
    "semver": "7.8.5",
    "yaml": "2.9.1"
  }
}
